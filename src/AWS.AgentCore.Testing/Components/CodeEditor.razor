@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="code-editor-container">
    <div class="code-editor-gutter" @ref="_gutterRef">
        @for (var i = 1; i <= _lineCount; i++)
        {
            <div class="gutter-line @(i == _activeLine ? "active" : "")">@i</div>
        }
    </div>
    <textarea @ref="_textareaRef"
              class="code-editor-textarea"
              value="@Value"
              @oninput="HandleInput"
              @onkeydown="HandleKeyDown"
              @onclick="UpdateActiveLine"
              @onkeyup="UpdateActiveLine"
              spellcheck="false"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              placeholder="@Placeholder"
              style="min-height: @(MinHeight)px"
              readonly="@ReadOnly">
    </textarea>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Language { get; set; } = "json";
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public int MinHeight { get; set; } = 200;

    private ElementReference _textareaRef;
    private ElementReference _gutterRef;
    private IJSObjectReference? _module;
    private int _lineCount = 1;
    private int _activeLine = 1;

    protected override void OnParametersSet()
    {
        _lineCount = Math.Max(1, (Value ?? "").Split('\n').Length);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/Components/CodeEditor.razor.js");
            await _module.InvokeVoidAsync("init", _textareaRef, _gutterRef);
        }
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        var newValue = e.Value?.ToString() ?? "";
        _lineCount = Math.Max(1, newValue.Split('\n').Length);
        await ValueChanged.InvokeAsync(newValue);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_module is null) return;

        if (e.Key == "Tab")
        {
            // Handled in JS to prevent focus loss
        }
        else if (e.Key == "Enter")
        {
            // Auto-indent handled in JS
        }
    }

    private async Task UpdateActiveLine()
    {
        if (_module is not null)
        {
            _activeLine = await _module.InvokeAsync<int>("getActiveLine", _textareaRef);
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
        }
    }
}
