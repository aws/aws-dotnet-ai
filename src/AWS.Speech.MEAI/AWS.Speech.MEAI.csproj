<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;netstandard2.0;net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>Latest</LangVersion>
        <Version>0.0.1-preview</Version>
        <IsPackable>true</IsPackable>
        <PackageId>AWS.Speech.MEAI</PackageId>
        <Product>AI Integrations on AWS for .NET</Product>
        <Authors>Amazon Web Services</Authors>
        <Company>Amazon Web Services</Company>
        <Description>Preview scaffold: Microsoft.Extensions.AI speech clients over Amazon Transcribe and Amazon Polly, plus a VoiceAgent that composes speech-to-text, an IChatClient, and text-to-speech into a full-duplex voice loop. The speech clients and VoiceAgent facade land in subsequent preview releases.</Description>
        <PackageTags>AWS;Amazon;Transcribe;Polly;Voice;Speech;AI;Microsoft.Extensions.AI;ISpeechToTextClient;ITextToSpeechClient</PackageTags>
        <PackageProjectUrl>https://github.com/aws/aws-dotnet-ai</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsAsErrors>true</WarningsAsErrors>
        <!-- CS0436: this package and AWS.Bedrock.MEAI (visible via InternalsVisibleTo) both define the
             System.Diagnostics.CodeAnalysis.ExperimentalAttribute polyfill on net472/netstandard2.0.
             The compiler uses this assembly's local copy, which is the intended behavior. -->
        <NoWarn>$(NoWarn);MEAI001;CS0436</NoWarn>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>..\..\public.snk</AssemblyOriginatorKeyFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <!-- Trimming is only supported on net8.0+; the realtime/orchestration APIs are net8.0-only. -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETCoreApp' And $([MSBuild]::VersionGreaterThanOrEquals($([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')), '8.0'))">
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.Polly" Version="4.0.100.8" />
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.3" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
    </ItemGroup>

    <!-- Amazon Transcribe streaming requires HTTP/2, which is unavailable on net472/netstandard2.0. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="AWSSDK.TranscribeStreaming" Version="4.0.101.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AWS.Bedrock.MEAI\AWS.Bedrock.MEAI.csproj" />
    </ItemGroup>

    <!-- Reference assemblies so net472 compiles on Linux CI (CodeBuild has .NET only). -->
    <ItemGroup Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETFramework'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AWS.Speech.MEAI.UnitTests, " />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\icon.png" Pack="true" PackagePath="" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
        <None Include="..\..\NOTICE" Pack="true" PackagePath="" />
        <None Include=".\README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
