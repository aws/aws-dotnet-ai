<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <Version>1.1.0</Version>
        <IsPackable>true</IsPackable>
        <PackageId>AWS.AgentCore.Hosting</PackageId>
        <Product>AI Integrations on AWS for .NET</Product>
        <Authors>Amazon Web Services</Authors>
        <Company>Amazon Web Services</Company>
        <Description>AI Integrations on AWS for .NET is a .NET library for building AI agents that deploy to Amazon Bedrock AgentCore</Description>
        <PackageProjectUrl>https://github.com/aws/aws-dotnet-ai</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RollForward>Major</RollForward>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
        <WarningsAsErrors>true</WarningsAsErrors>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>..\..\public.snk</AssemblyOriginatorKeyFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="AWSSDK.BedrockAgentCore" Version="4.0.23" />
        <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.17.5" />
        <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.3.35" />
        <PackageReference Include="Microsoft.Agents.AI" Version="1.3.0" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
        <PackageReference Include="OpenTelemetry" Version="1.16.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AWS.AgentCore.SourceGenerator\AWS.AgentCore.SourceGenerator.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" SetTargetFramework="TargetFramework=netstandard2.0" />
        <ProjectReference Include="..\AWS.Bedrock.MEAI\AWS.Bedrock.MEAI.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackSourceGenerator</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="_GenerateAssemblyVersionConstant" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <_AgentCoreVersion>$(Version)</_AgentCoreVersion>
        </PropertyGroup>
        <WriteLinesToFile File="$(IntermediateOutputPath)AssemblyVersion.g.cs" Lines="namespace AWS.AgentCore.Hosting.Internal { internal static partial class UserAgentTelemetry { internal const string AssemblyVersion = &quot;$(_AgentCoreVersion)&quot;%3B } }" Overwrite="true" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)AssemblyVersion.g.cs" />
        </ItemGroup>
    </Target>

    <Target Name="_PackSourceGenerator">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\AWS.AgentCore.SourceGenerator\bin\$(Configuration)\netstandard2.0\AWS.AgentCore.SourceGenerator.dll" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <InternalsVisibleTo Include="AWS.AgentCore.Hosting.UnitTests, " />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\icon.png" Pack="true" PackagePath="" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
        <None Include="..\..\NOTICE" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <None Include=".\README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
