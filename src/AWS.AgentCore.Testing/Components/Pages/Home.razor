@page "/"
@using System.Text.Json
@using System.Text.RegularExpressions
@using AWS.AgentCore.Testing.Models
@using AWS.AgentCore.Testing.Services
@using Markdig
@using Microsoft.Extensions.Options
@inject AgentCoreService AgentService
@inject ChatSessionManager SessionManager
@inject IOptions<AgentCoreSettings> Settings
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>AgentCore Testing</PageTitle>

<div class="chat-container">
    <header class="chat-header">
        <div class="chat-header-inner">
            <img class="chat-header-logo" src="@(_isDarkMode ? "aws-light.svg" : "aws.svg")" width="24" height="24" alt="AWS" />
            <span class="chat-header-title">Amazon Bedrock AgentCore</span>
            @if (UseStreaming)
            {
                <span class="badge badge-streaming">Streaming</span>
            }
            @if (CurrentSession is not null && CurrentSession.Messages.Count > 0)
            {
                <span class="chat-header-session">@CurrentSession.Title</span>
            }
            <div class="header-actions">
                <button class="icon-btn @(_showPayloadEditor ? "active" : "")" @onclick="TogglePayloadEditor" title="Configure request payload">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="16 18 22 12 16 6"/>
                        <polyline points="8 6 2 12 8 18"/>
                    </svg>
                </button>
                <button class="icon-btn" @onclick="ToggleTheme" title="Toggle light/dark mode">
                    @if (_isDarkMode)
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                        </svg>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                        </svg>
                    }
                </button>
            </div>
        </div>
    </header>

    <div class="chat-body">
        <div class="chat-main">
            @if (CurrentSession is null || CurrentSession.Messages.Count == 0)
            {
                <div class="welcome-container">
                    <div class="welcome-content">
                        <div class="welcome-icon">
                            <img src="@(_isDarkMode ? "aws-light.svg" : "aws.svg")" width="48" height="48" alt="AWS" />
                        </div>
                        <h1 class="welcome-title">Test Your Agent</h1>
                        <p class="welcome-subtitle">Send requests to your AgentCore runtime and see responses in real time.</p>

                        <div class="quick-actions">
                            <button class="quick-action" @onclick="SendDefaultPrompt">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
                                </svg>
                                <span>Send test message</span>
                            </button>
                            <button class="quick-action" @onclick="TogglePayloadEditor">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                                </svg>
                                <span>Configure payload</span>
                            </button>
                        </div>

                        <div class="welcome-payload-preview">
                            <div class="welcome-payload-header">
                                <span class="welcome-payload-label">Current payload</span>
                                @if (_parameters.Count > 0)
                                {
                                    <div class="welcome-params">
                                        @foreach (var p in _parameters)
                                        {
                                            <span class="param-chip">@p.Name</span>
                                        }
                                    </div>
                                }
                            </div>
                            <pre class="welcome-payload-code">@_payloadTemplate</pre>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="messages-container" @ref="_messagesContainer">
                    <div class="messages-inner">
                        @foreach (var message in CurrentSession.Messages)
                        {
                            <div class="message-row @(message.Role == ChatRole.User ? "user" : "assistant")">
                                <div class="message-wrapper">
                                    <div class="message-avatar">
                                        @if (message.Role == ChatRole.User)
                                        {
                                            <div class="avatar user-avatar">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                                    <circle cx="12" cy="7" r="4"/>
                                                </svg>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="avatar assistant-avatar">
                                                <img src="@(_isDarkMode ? "aws-light.svg" : "aws.svg")" width="16" height="16" alt="AWS" />
                                            </div>
                                        }
                                    </div>
                                    <div class="message-content">
                                        <div class="message-meta">
                                            <span class="message-role">@(message.Role == ChatRole.User ? "You" : "Agent")</span>
                                            <span class="message-time">@message.Timestamp.ToString("HH:mm")</span>
                                        </div>
                                        <div class="message-text @(message.Role == ChatRole.Assistant ? "markdown-content" : "")">
                                            @if (message.Role == ChatRole.Assistant)
                                            {
                                                @if (string.IsNullOrEmpty(message.Content) && _isLoading)
                                                {
                                                    <div class="thinking-indicator">
                                                        <div class="thinking-dot"></div>
                                                        <div class="thinking-dot"></div>
                                                        <div class="thinking-dot"></div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @((MarkupString)RenderMarkdown(message.Content))
                                                }
                                            }
                                            else
                                            {
                                                @message.Content
                                            }
                                        </div>
                                        @if (message.Role == ChatRole.Assistant && !string.IsNullOrEmpty(message.Content))
                                        {
                                            <div class="message-actions">
                                                <button class="action-btn" @onclick="() => CopyMessage(message.Content)" title="Copy response">
                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                                                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                                                    </svg>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Input area with dynamic parameter fields -->
            <div class="input-area">
                @if (_parameters.Count > 0)
                {
                    <div class="param-inputs">
                        @foreach (var param in _parameters)
                        {
                            <div class="param-input-group">
                                <label class="param-input-label" for="@($"param-{param.Name}")">@param.Name</label>
                                <input type="text"
                                       id="@($"param-{param.Name}")"
                                       class="param-input-field"
                                       placeholder="@(string.IsNullOrEmpty(param.DefaultValue) ? $"Enter {param.Name}..." : param.DefaultValue)"
                                       value="@param.CurrentValue"
                                       @oninput="(e) => UpdateParamValue(param.Name, e.Value as string)"
                                       disabled="@_isLoading" />
                            </div>
                        }
                    </div>
                }
                <div class="input-wrapper @(_isLoading ? "loading" : "")">
                    <textarea
                        @ref="_textInput"
                        @bind="_userInput"
                        @bind:event="oninput"
                        @onkeydown="HandleKeyDown"
                        placeholder="@GetInputPlaceholder()"
                        rows="1"
                        disabled="@_isLoading"
                        class="chat-input">
                    </textarea>
                    <div class="input-actions">
                        @if (_isLoading)
                        {
                            <button class="stop-btn" @onclick="CancelRequest" title="Stop generating">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                    <rect x="6" y="6" width="12" height="12" rx="2"/>
                                </svg>
                            </button>
                        }
                        else
                        {
                            <button class="send-btn @(string.IsNullOrWhiteSpace(_userInput) ? "disabled" : "")"
                                    @onclick="SendMessage"
                                    disabled="@(string.IsNullOrWhiteSpace(_userInput))"
                                    title="Send (Enter)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
                                </svg>
                            </button>
                        }
                    </div>
                </div>
                <div class="input-hint">
                    <span>Enter to send &middot; Shift+Enter for new line</span>
                </div>
            </div>
        </div>

        @if (_showPayloadEditor)
        {
            <aside class="payload-panel">
                <div class="panel-header">
                    <div class="panel-header-left">
                        <h3>Payload Editor</h3>
                        <span class="panel-badge">JSON</span>
                    </div>
                    <button class="icon-btn" @onclick="TogglePayloadEditor" title="Close (Esc)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>
                <div class="panel-body">
                    <div class="panel-section">
                        <div class="section-header">
                            <h4>Request Template</h4>
                            <button class="text-btn" @onclick="FormatPayload" title="Format JSON">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/>
                                </svg>
                                Format
                            </button>
                        </div>
                        <p class="panel-description">
                            Define the JSON body sent to your agent. Use <code>@("{{paramName}}")</code> placeholders for dynamic values.
                            The placeholder <code>@("{{input}}")</code> maps to the chat input box.
                        </p>
                        <CodeEditor @bind-Value="_payloadTemplate"
                                    Language="json"
                                    Placeholder="Enter your JSON payload template..."
                                    MinHeight="200" />
                        @if (!string.IsNullOrEmpty(_payloadError))
                        {
                            <div class="editor-error">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                                </svg>
                                @_payloadError
                            </div>
                        }
                    </div>

                    <div class="panel-section">
                        <div class="section-header clickable" @onclick="ToggleParametersExpanded">
                            <div class="section-header-left">
                                <svg class="collapse-chevron @(_parametersExpanded ? "expanded" : "")" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"/>
                                </svg>
                                <h4>Parameters</h4>
                                @if (_parameters.Count > 0)
                                {
                                    <span class="section-count">@_parameters.Count</span>
                                }
                            </div>
                            <button class="text-btn accent" @onclick="AddParameter" @onclick:stopPropagation="true">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                                </svg>
                                Add
                            </button>
                        </div>

                        @if (_parametersExpanded)
                        {
                            <p class="panel-description">
                                Parameters become input fields in the chat area. Use them in your template as <code>@("{{name}}")</code>.
                                The built-in <code>@("{{input}}")</code> is always the main chat text box.
                            </p>

                            @if (_parameters.Count == 0)
                            {
                                <div class="params-empty">
                                    <span>No custom parameters defined.</span>
                                    <span>Use <code>@("{{input}}")</code> in your template for the chat message.</span>
                                </div>
                            }
                            else
                            {
                                <div class="params-list">
                                    @foreach (var param in _parameters)
                                    {
                                        <div class="param-card @(param.IsExpanded ? "expanded" : "")">
                                            <div class="param-card-header" @onclick="() => ToggleParamExpanded(param.Name)">
                                                <svg class="collapse-chevron @(param.IsExpanded ? "expanded" : "")" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="9 18 15 12 9 6"/>
                                                </svg>
                                                <div class="param-card-name">
                                                    <code>@($"{{{{{param.Name}}}}}")</code>
                                                </div>
                                                <span class="param-type-badge">@param.Type</span>
                                                <button class="param-delete-btn" @onclick="() => RemoveParameter(param.Name)" @onclick:stopPropagation="true" title="Remove parameter">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                                                    </svg>
                                                </button>
                                            </div>
                                            @if (param.IsExpanded)
                                            {
                                                <div class="param-card-fields">
                                                    <div class="param-field">
                                                        <label>Name</label>
                                                        <input type="text" value="@param.Name"
                                                               @onchange="(e) => RenameParameter(param.Name, e.Value as string)"
                                                               placeholder="paramName" spellcheck="false" />
                                                    </div>
                                                    <div class="param-field">
                                                        <label>Default value</label>
                                                        <input type="text" value="@param.DefaultValue"
                                                               @oninput="(e) => UpdateParamDefault(param.Name, e.Value as string)"
                                                               placeholder="Optional default" />
                                                    </div>
                                                    <div class="param-field">
                                                        <label>Type</label>
                                                        <select value="@param.Type" @onchange="(e) => UpdateParamType(param.Name, e.Value as string)">
                                                            <option value="string">String</option>
                                                            <option value="number">Number</option>
                                                            <option value="boolean">Boolean</option>
                                                            <option value="raw">Raw JSON</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <div class="panel-section">
                        <div class="section-header">
                            <h4>Templates</h4>
                        </div>
                        <div class="template-list">
                            @foreach (var template in _builtInTemplates)
                            {
                                <button class="template-btn" @onclick="() => ApplyTemplate(template)">
                                    <span class="template-name">@template.Name</span>
                                    <span class="template-desc">@template.Description</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="panel-section">
                        <div class="section-header">
                            <h4>Live Preview</h4>
                        </div>
                        <pre class="live-preview">@GetPayloadPreview()</pre>
                    </div>
                </div>
            </aside>
        }
    </div>
</div>

@code {
    private string _userInput = string.Empty;
    private string _payloadTemplate = "{\n  \"prompt\": \"{{input}}\"\n}";
    private string _payloadError = string.Empty;
    private bool _isLoading;
    private bool _showPayloadEditor;
    private ElementReference _messagesContainer;
    private ElementReference _textInput;
    private CancellationTokenSource? _cts;
    private List<PayloadParameter> _parameters = new();
    private bool _parametersExpanded = true;
    private bool _isDarkMode = true;

    private bool UseStreaming => Settings.Value.UseStreaming;

    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private ChatSession? CurrentSession => SessionManager.ActiveSession;

    private record PayloadTemplate(string Name, string Description, string Template, PayloadParameter[]? Parameters = null);

    private class PayloadParameter
    {
        public string Name { get; set; } = "";
        public string DefaultValue { get; set; } = "";
        public string CurrentValue { get; set; } = "";
        public string Type { get; set; } = "string"; // string, number, boolean, raw
        public bool IsExpanded { get; set; }
    }

    private static readonly PayloadTemplate[] _builtInTemplates =
    [
        new("Simple Prompt", "Single prompt field",
            "{\n  \"prompt\": \"{{input}}\"\n}"),
        new("Message + Role", "Chat-style with role specification",
            "{\n  \"message\": \"{{input}}\",\n  \"role\": \"{{role}}\"\n}",
            [new() { Name = "role", DefaultValue = "user", Type = "string" }]),
        new("Query + Parameters", "With model tuning parameters",
            "{\n  \"query\": \"{{input}}\",\n  \"parameters\": {\n    \"temperature\": {{temperature}},\n    \"maxTokens\": {{maxTokens}}\n  }\n}",
            [
                new() { Name = "temperature", DefaultValue = "0.7", Type = "number" },
                new() { Name = "maxTokens", DefaultValue = "1024", Type = "number" }
            ]),
        new("Structured Input", "Nested input with metadata",
            "{\n  \"input\": {\n    \"text\": \"{{input}}\",\n    \"type\": \"{{messageType}}\"\n  },\n  \"metadata\": {\n    \"source\": \"{{source}}\",\n    \"userId\": \"{{userId}}\"\n  }\n}",
            [
                new() { Name = "messageType", DefaultValue = "user_message", Type = "string" },
                new() { Name = "source", DefaultValue = "testing-ui", Type = "string" },
                new() { Name = "userId", DefaultValue = "dev-user-1", Type = "string" }
            ]),
        new("RAG Query", "Retrieval-augmented generation",
            "{\n  \"question\": \"{{input}}\",\n  \"context\": {\n    \"knowledgeBaseId\": \"{{knowledgeBaseId}}\",\n    \"maxResults\": {{maxResults}},\n    \"filters\": {{filters}}\n  }\n}",
            [
                new() { Name = "knowledgeBaseId", DefaultValue = "kb-default", Type = "string" },
                new() { Name = "maxResults", DefaultValue = "5", Type = "number" },
                new() { Name = "filters", DefaultValue = "{}", Type = "raw" }
            ]),
        new("Multi-turn Chat", "Conversational with history flag",
            "{\n  \"message\": \"{{input}}\",\n  \"includeHistory\": {{includeHistory}},\n  \"systemPrompt\": \"{{systemPrompt}}\"\n}",
            [
                new() { Name = "includeHistory", DefaultValue = "true", Type = "boolean" },
                new() { Name = "systemPrompt", DefaultValue = "You are a helpful assistant.", Type = "string" }
            ])
    ];

    protected override void OnInitialized()
    {
        SessionManager.OnChange += HandleSessionChange;
    }

    private void HandleSessionChange()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedTheme = await Js.InvokeAsync<string>("eval",
                "(document.cookie.match(/agentcore-theme=([^;]+)/) || [])[1] || ''");
            if (!string.IsNullOrEmpty(savedTheme))
            {
                _isDarkMode = savedTheme == "dark";
                await Js.InvokeVoidAsync("eval", $"document.documentElement.setAttribute('data-theme', '{savedTheme}')");
                StateHasChanged();
            }
            await FocusInput();
        }
        await ScrollToBottom();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendDefaultPrompt()
    {
        _userInput = "Hello! Can you tell me what you can help me with?";
        await SendMessage();
    }

    private void TogglePayloadEditor()
    {
        _showPayloadEditor = !_showPayloadEditor;
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        var theme = _isDarkMode ? "dark" : "light";
        await Js.InvokeVoidAsync("eval", $"document.documentElement.setAttribute('data-theme', '{theme}'); document.cookie = 'agentcore-theme={theme}; path=/; max-age=31536000; SameSite=Lax'");
    }

    private string GetInputPlaceholder()
    {
        if (_payloadTemplate.Contains("{{input}}"))
            return "Type a message...";
        return "Type a message (not used in current template)...";
    }

    // --- Parameter Management ---

    private void ToggleParametersExpanded()
    {
        _parametersExpanded = !_parametersExpanded;
    }

    private void AddParameter()
    {
        var name = $"param{_parameters.Count + 1}";
        _parameters.Add(new PayloadParameter { Name = name, IsExpanded = true });
    }

    private void ToggleParamExpanded(string name)
    {
        var param = _parameters.FirstOrDefault(p => p.Name == name);
        if (param is not null)
            param.IsExpanded = !param.IsExpanded;
    }

    private void RemoveParameter(string name)
    {
        _parameters.RemoveAll(p => p.Name == name);
    }

    private void RenameParameter(string oldName, string? newName)
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        newName = Regex.Replace(newName.Trim(), @"[^a-zA-Z0-9_]", "");
        if (string.IsNullOrEmpty(newName) || _parameters.Any(p => p.Name == newName && p.Name != oldName)) return;

        var param = _parameters.FirstOrDefault(p => p.Name == oldName);
        if (param is not null)
            param.Name = newName;
    }

    private void UpdateParamDefault(string name, string? value)
    {
        var param = _parameters.FirstOrDefault(p => p.Name == name);
        if (param is not null)
            param.DefaultValue = value ?? "";
    }

    private void UpdateParamValue(string name, string? value)
    {
        var param = _parameters.FirstOrDefault(p => p.Name == name);
        if (param is not null)
            param.CurrentValue = value ?? "";
    }

    private void UpdateParamType(string name, string? type)
    {
        var param = _parameters.FirstOrDefault(p => p.Name == name);
        if (param is not null)
            param.Type = type ?? "string";
    }

    // --- Template Application ---

    private void ApplyTemplate(PayloadTemplate template)
    {
        _payloadTemplate = template.Template;
        _payloadError = string.Empty;

        if (template.Parameters is not null)
        {
            _parameters = template.Parameters
                .Select(p => new PayloadParameter
                {
                    Name = p.Name,
                    DefaultValue = p.DefaultValue,
                    CurrentValue = p.DefaultValue,
                    Type = p.Type
                })
                .ToList();
        }
        else
        {
            _parameters.Clear();
        }
    }

    private void FormatPayload()
    {
        var formatted = FormatJsonTemplate(_payloadTemplate);
        if (formatted is not null)
        {
            _payloadTemplate = formatted;
            _payloadError = string.Empty;
        }
        else
        {
            _payloadError = "Cannot format: template is not valid JSON structure.";
        }
    }

    private static string? FormatJsonTemplate(string template)
    {
        // Replace "{{name}}" (quoted placeholders) with unique valid JSON strings
        // Replace {{name}} (unquoted placeholders) with unique valid JSON numbers
        var quotedPlaceholders = new Dictionary<string, string>();
        var unquotedPlaceholders = new Dictionary<string, string>();
        var i = 0;

        // First pass: replace quoted "{{name}}" with a simple placeholder string value
        var replaced = Regex.Replace(template, @"""(\{\{\w+\}\})""", m =>
        {
            var token = $"\"__QPH{i}__\"";
            quotedPlaceholders[token] = m.Value;
            // Also handle the escaped version that JsonSerializer produces
            quotedPlaceholders[$"\"__QPH{i}__\""] = m.Value;
            i++;
            return token;
        });

        // Second pass: replace bare {{name}} (unquoted, used for numbers/bools/raw) with a placeholder number
        replaced = Regex.Replace(replaced, @"\{\{\w+\}\}", m =>
        {
            var token = $"9{i:D6}";
            unquotedPlaceholders[token] = m.Value;
            i++;
            return token;
        });

        try
        {
            using var doc = JsonDocument.Parse(replaced);
            var formatted = JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });

            // Restore quoted placeholders
            foreach (var (token, original) in quotedPlaceholders)
            {
                formatted = formatted.Replace(token, original);
            }

            // Restore unquoted placeholders
            foreach (var (token, original) in unquotedPlaceholders)
            {
                formatted = formatted.Replace(token, original);
            }

            return formatted;
        }
        catch
        {
            return null;
        }
    }

    // --- Payload Building ---

    private string BuildPayload(string userInput)
    {
        var payload = _payloadTemplate;

        // Replace {{input}} with the user's message
        payload = ReplaceParameter(payload, "input", userInput, "string");

        // Replace all custom parameters
        foreach (var param in _parameters)
        {
            var value = string.IsNullOrEmpty(param.CurrentValue) ? param.DefaultValue : param.CurrentValue;
            payload = ReplaceParameter(payload, param.Name, value, param.Type);
        }

        // Validate the final JSON
        try
        {
            using var doc = JsonDocument.Parse(payload);
            _payloadError = string.Empty;
            return payload;
        }
        catch (JsonException ex)
        {
            _payloadError = $"Invalid JSON: {ex.Message}";
            return JsonSerializer.Serialize(new { prompt = userInput });
        }
    }

    private static string ReplaceParameter(string template, string name, string value, string type)
    {
        var placeholder = $"{{{{{name}}}}}";

        return type switch
        {
            "number" => template.Replace(placeholder, string.IsNullOrEmpty(value) ? "0" : value),
            "boolean" => template.Replace(placeholder, string.IsNullOrEmpty(value) ? "false" : value.ToLowerInvariant()),
            "raw" => template.Replace(placeholder, string.IsNullOrEmpty(value) ? "null" : value),
            _ => template.Replace(placeholder, EscapeJsonString(value))
        };
    }

    private static string EscapeJsonString(string input)
    {
        return input
            .Replace("\\", "\\\\")
            .Replace("\"", "\\\"")
            .Replace("\n", "\\n")
            .Replace("\r", "\\r")
            .Replace("\t", "\\t");
    }

    private string GetPayloadPreview()
    {
        var payload = _payloadTemplate;
        payload = ReplaceParameter(payload, "input", _userInput.Length > 0 ? _userInput : "Hello, agent!", "string");

        foreach (var param in _parameters)
        {
            var value = string.IsNullOrEmpty(param.CurrentValue) ? param.DefaultValue : param.CurrentValue;
            if (string.IsNullOrEmpty(value)) value = $"<{param.Name}>";
            payload = ReplaceParameter(payload, param.Name, value, param.Type);
        }

        try
        {
            using var doc = JsonDocument.Parse(payload);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return payload;
        }
    }

    // --- Message Sending ---

    private async Task SendMessage()
    {
        var input = _userInput?.Trim();
        if (string.IsNullOrEmpty(input) || _isLoading)
            return;

        _userInput = string.Empty;
        _isLoading = true;

        var session = SessionManager.GetOrCreateActiveSession();

        var userMessage = new ChatMessage
        {
            Role = ChatRole.User,
            Content = input
        };
        SessionManager.AddMessage(session.Id, userMessage);

        StateHasChanged();
        await Task.Delay(50);

        var assistantMessage = new ChatMessage
        {
            Role = ChatRole.Assistant,
            Content = "",
        };
        SessionManager.AddMessage(session.Id, assistantMessage);

        try
        {
            _cts = new CancellationTokenSource();
            var payload = BuildPayload(input);

            if (UseStreaming)
            {
                await foreach (var chunk in AgentService.InvokeAgentStreamingAsync(payload, session.Id, cancellationToken: _cts.Token))
                {
                    assistantMessage.Content += chunk;
                    StateHasChanged();
                    await Task.Delay(10);
                }
            }
            else
            {
                var response = await AgentService.InvokeAgentAsync(payload, session.Id, cancellationToken: _cts.Token);
                assistantMessage.Content = response;
            }
        }
        catch (OperationCanceledException)
        {
            SessionManager.UpdateMessage(session.Id, assistantMessage.Id, "*Request cancelled.*");
        }
        catch (Exception ex)
        {
            var errorContent = $"**Error:** {ex.Message}";
            SessionManager.UpdateMessage(session.Id, assistantMessage.Id, errorContent);
        }
        finally
        {
            _isLoading = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
            await FocusInput();
        }
    }

    private void CancelRequest()
    {
        _cts?.Cancel();
    }

    private static readonly Ganss.Xss.HtmlSanitizer HtmlSanitizer = CreateSanitizer();

    private static Ganss.Xss.HtmlSanitizer CreateSanitizer()
    {
        var sanitizer = new Ganss.Xss.HtmlSanitizer();
        sanitizer.AllowedSchemes.Add("data");
        return sanitizer;
    }

    private static string RenderMarkdown(string? content)
    {
        if (string.IsNullOrEmpty(content))
            return string.Empty;
        var rawHtml = Markdown.ToHtml(content, MarkdownPipeline);
        return HtmlSanitizer.Sanitize(rawHtml);
    }

    private async Task CopyMessage(string content)
    {
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", content);
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Js.InvokeVoidAsync("eval", "document.querySelector('.messages-container')?.scrollTo({ top: document.querySelector('.messages-container')?.scrollHeight, behavior: 'smooth' })");
        }
        catch { }
    }

    private async Task FocusInput()
    {
        try
        {
            await _textInput.FocusAsync();
        }
        catch { }
    }

    public void Dispose()
    {
        SessionManager.OnChange -= HandleSessionChange;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
