{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": ["**/*.csproj"]
        }
      ],
      "dest": "api",
      "filter": "filter.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "exclude": ["_site/**", "filter.yml"]
      }
    ],
    "resource": [
      {
        "files": ["assets/images/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern", "template"],
    "globalMetadata": {
      "_appName": "",
      "_appTitle": "Amazon Bedrock AgentCore for .NET",
      "_appLogoPath": "assets/images/aws-logo.svg",
      "_appFaviconPath": "assets/images/favicon.ico",
      "_enableSearch": true,
      "pdf": false,
      "_disableContribution": true,
      "_appFooter": "<div class='text-center'>© 2026, Amazon Web Services, Inc. or its affiliates. All rights reserved.</div><script src=../public/beacon_scode.js></script>"
    }
  }
}
