<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>Latest</LangVersion>
        <IsAotCompatible>true</IsAotCompatible>
        <Version>0.1.0-preview</Version>
        <IsPackable>true</IsPackable>
        <PackageId>AWS.Bedrock.MAG</PackageId>
        <Product>AI Integrations on AWS for .NET</Product>
        <Authors>Amazon Web Services</Authors>
        <Company>Amazon Web Services</Company>
        <Description>AWS backends for Microsoft's Agent Governance Toolkit: a Bedrock Guardrails policy backend, Bedrock Guardrails PII sanitization for MCP tool output, and a CloudWatch audit sink.</Description>
        <PackageTags>AWS;Amazon;Bedrock;Guardrails;AgentGovernance;MCP;CloudWatch;AI;Governance</PackageTags>
        <PackageProjectUrl>https://github.com/aws/aws-dotnet-ai</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>..\..\public.snk</AssemblyOriginatorKeyFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.17.5" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AWS.Bedrock.MAG.UnitTests, " />
        <InternalsVisibleTo Include="AWS.Bedrock.MAG.IntegrationTests, " />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\icon.png" Pack="true" PackagePath="" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
        <None Include="..\..\NOTICE" Pack="true" PackagePath="" />
        <None Include=".\README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
