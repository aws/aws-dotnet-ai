@using AWS.AgentCore.Testing.Services
@inject ChatSessionManager SessionManager
@implements IDisposable

<aside class="sidebar @(IsCollapsed ? "collapsed" : "")">
    <div class="sidebar-header">
        <button class="sidebar-toggle" @onclick="ToggleSidebar" title="Toggle sidebar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="9" y1="3" x2="9" y2="21"></line>
            </svg>
        </button>
        @if (!IsCollapsed)
        {
            <button class="new-chat-btn" @onclick="CreateNewChat" title="New chat">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>New session</span>
            </button>
        }
        else
        {
            <button class="sidebar-toggle" @onclick="CreateNewChat" title="New chat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </button>
        }
    </div>

    @if (!IsCollapsed)
    {
        <div class="sidebar-sessions">
            @if (!SessionManager.Sessions.Any())
            {
                <div class="sessions-empty">
                    <span>No sessions yet</span>
                </div>
            }
            else
            {
                @foreach (var session in SessionManager.Sessions)
                {
                    <div class="session-item @(session.Id == SessionManager.ActiveSession?.Id ? "active" : "")"
                         @onclick="() => SelectSession(session.Id)">
                        <svg class="session-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span class="session-title">@session.Title</span>
                        <button class="session-delete" @onclick="() => DeleteSession(session.Id)" @onclick:stopPropagation="true" title="Delete">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                        </button>
                    </div>
                }
            }
        </div>

    }
</aside>

@code {
    private bool IsCollapsed { get; set; }

    protected override void OnInitialized()
    {
        SessionManager.OnChange += StateHasChanged;
    }

    private void ToggleSidebar()
    {
        IsCollapsed = !IsCollapsed;
    }

    private void CreateNewChat()
    {
        SessionManager.CreateSession();
    }

    private void SelectSession(string sessionId)
    {
        SessionManager.SetActiveSession(sessionId);
    }

    private void DeleteSession(string sessionId)
    {
        SessionManager.DeleteSession(sessionId);
    }

    public void Dispose()
    {
        SessionManager.OnChange -= StateHasChanged;
    }
}
