<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!--
          The MEAI package itself targets net472/netstandard2.0/net8.0 (see the src csproj), but the
          CI runs on Linux (Amazon Linux ARM64) where the net472 test TFM cannot execute without Mono.
          For now the tests run on net8.0 only; running the net472 tests (via Mono or a Windows runner)
          is tracked as a follow-up. The src package still builds net472 for compile coverage.
        -->
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>Latest</LangVersion>
        <IsPackable>false</IsPackable>
        <!-- MEAI001: uses evaluation-stage Microsoft.Extensions.AI APIs. -->
        <NoWarn>$(NoWarn);MEAI001</NoWarn>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>..\..\public.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.1" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
        <PackageReference Include="Moq" Version="4.20.72" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\AWS.Bedrock.MEAI\AWS.Bedrock.MEAI.csproj" />
    </ItemGroup>

</Project>
